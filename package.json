{
  "name": "millionsend-monorepo",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "setup:aws": "tsx scripts/aws-setup/index.ts",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @millionsend/db db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "tsx": "^4.23.12",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2"
  }
}
