# --- Required everywhere ---
DATABASE_URL=postgres://millionsend:millionsend@localhost:5432/millionsend

# Self-host KEK for email-body encryption at rest (32 bytes, base64).
# Generate: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=

# --- AWS SES (self-host: bring your own account) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public base URL of this deployment (SNS callbacks, hosted unsubscribe pages).
APP_BASE_URL=http://localhost:3000

# --- Cloud only (leave unset when self-hosting) ---
IS_CLOUD=false
# KMS_KEY_ID=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
