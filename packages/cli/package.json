{
  "name": "@millionsend/cli",
  "version": "0.1.1",
  "description": "Migrate an email account to MillionSend: contacts, segments, topics, templates, webhooks, domains and suppressions — read from the source provider, written to your MillionSend instance, re-run safe",
  "license": "MIT",
  "type": "module",
  "bin": {
    "millionsend": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MillionSend/millionsend.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/MillionSend/millionsend/tree/main/packages/cli#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/index.js --banner:js='#!/usr/bin/env node' --define:__CLI_VERSION__=\"\\\"$npm_package_version\\\"\"",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.7",
    "@millionsend/api": "workspace:*",
    "@millionsend/core": "workspace:*",
    "@millionsend/db": "workspace:*",
    "@millionsend/test-utils": "workspace:*",
    "@types/node": "^26.4.0",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
