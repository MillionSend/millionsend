# Copy to .env and fill in; README.md next to this file walks through each value.

# Let's Encrypt account address: expiry notices go here.
ACME_EMAIL=you@example.com

# The app, for both the ask gate and the /t/* reverse proxy. ORIGIN is the full
# URL Caddy connects to; ORIGIN_HOST is the Host header it sends (so a CDN in
# front of the app routes to the right site). ASK_URL must carry
# ?token=<the app's TRACKING_ASK_SECRET>; Caddy appends &domain=<hostname> on
# each check.
ORIGIN=https://mail.example.com
ORIGIN_HOST=mail.example.com
ASK_URL=https://mail.example.com/internal/tracking-host-allowed?token=REPLACE_WITH_TRACKING_ASK_SECRET

# The box's own hostname: the app's TRACKING_EDGE_HOST, the CNAME target teams
# point their tracking subdomains at. Opening it directly 302s to EDGE_REDIRECT:
# it is not a tracking link, so a stray visit lands on a page instead of a dead
# handshake.
EDGE_HOST=track.example-dns.com
EDGE_REDIRECT=https://example.com
